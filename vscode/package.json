{
  "name": "mac-winform",
  "displayName": "Mac WinForms",
  "publisher": "local",
  "version": "0.2.1",
  "description": "Build and launch WinForms projects with the native Mac compatibility runtime.",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onDebugResolve:mac-winform", "onDebugDynamicConfigurations:mac-winform"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "contributes": {
    "configurationDefaults": {
      "dotnet.server.environmentVariables": { "EnableWindowsTargeting": "true" }
    },
    "commands": [
      { "command": "mac-winform.run", "category": "Mac WinForms", "title": "Run Project", "enablement": "isMac && isWorkspaceTrusted" },
      { "command": "mac-winform.build", "category": "Mac WinForms", "title": "Build Project", "enablement": "isMac && isWorkspaceTrusted" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "mac-winform.run", "when": "isMac && resourceExtname =~ /\\.(cs|vb|fs)proj$/", "group": "navigation" },
        { "command": "mac-winform.build", "when": "isMac && resourceExtname =~ /\\.(cs|vb|fs)proj$/", "group": "navigation" }
      ]
    },
    "taskDefinitions": [{
      "type": "mac-winform",
      "required": ["action", "project"],
      "properties": {
        "action": { "type": "string", "enum": ["build", "run"] },
        "project": { "type": "string", "description": "Project path relative to its workspace folder." },
        "args": { "type": "array", "items": { "type": "string" }, "description": "Application arguments for run." }
      },
      "when": "isMac"
    }],
    "debuggers": [{
      "type": "mac-winform",
      "label": "Mac WinForms",
      "languages": ["csharp", "vb", "fsharp"],
      "when": "isMac",
      "configurationAttributes": {
        "launch": {
          "properties": {
            "project": { "type": "string", "description": "Optional path to a project. Omit to choose interactively." },
            "args": { "type": "array", "items": { "type": "string" }, "description": "Arguments to the application." }
          }
        }
      },
      "initialConfigurations": [
        { "type": "mac-winform", "name": "Mac WinForms: Launch Project", "request": "launch" }
      ]
    }]
  }
}
